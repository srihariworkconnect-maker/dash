{
  "manifestVersion": 1,
  "id": "sandpiper-quality-insights-dashboard",
  "name": "Sandpiper QA Command Center",
  "version": "1.0.1",
  "description": "Live Azure DevOps test-plan analytics and execution history.",
  "publisher": "SandpiperQualityEngineering",
  "public": false,
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "categories": ["Azure Boards"],
  "scopes": ["vso.test"],
  "contributions": [{
    "id": "sandpiper-qa-widget",
    "type": "ms.vss-dashboards-web.widget",
    "targets": ["ms.vss-dashboards-web.widget-catalog"],
    "properties": {
      "name": "Sandpiper QA Command Center",
      "description": "Live test-point outcomes and retained execution history.",
      "catalogIconUrl": "dist/favicon.png",
      "uri": "dist/index.html",
      "supportedSizes": [{ "rowSpan": 4, "columnSpan": 4 }],
      "supportedScopes": ["project_team"]
    }
  }],
  "files": [{ "path": "dist", "addressable": true }]
}
