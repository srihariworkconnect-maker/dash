# Standalone development uses /api through the Vite proxy by default.
# This environment variable is read only by the development server:
# SANDPIPER_API_PROXY_TARGET=http://localhost:5243

# Installed-extension builds require an approved HTTPS API endpoint including /api.
# Do not supply a localhost URL for production builds. Configuring a URL does not
# establish caller authentication; the current API intentionally rejects production data requests.
# VITE_API_BASE_URL=https://approved-api-host.example/api
